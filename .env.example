# Copy to .env. Never commit .env or share secret values.
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Admin area: only the confirmed Supabase account with this exact e-mail is allowed.
ADMIN_EMAIL=u5877997@gmail.com
SUPPORT_EMAIL=u5877997@gmail.com
SUPPORT_PHONE=+905338227618
# Set a stable random secret in production to sign guest quota cookies (at least 32 random characters).
GUEST_HASH_SECRET=replace-with-a-long-random-secret-before-production
GUEST_GENERATION_LIMIT=3

# Supabase: Project Settings -> API. The anon key is public; service role is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API Platform key (not the same as a ChatGPT subscription).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# No card payments are active yet. Keep this OFF until a provider integration + verified webhook exist.
PAYMENT_PROVIDER=none
# Never place card number/CVV or API secrets in public/index.html.
